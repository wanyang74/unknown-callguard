# Set these as Fly secrets (fly secrets set KEY=value ...), never commit real values.
ANTHROPIC_API_KEY=sk-ant-...
TWILIO_AUTH_TOKEN=...              # Twilio Console > Account info
TWILIO_NUMBER=+15551234567         # the number you buy in Twilio
MY_CELL=+15557654321               # your US Mobile number
PUBLIC_BASE_URL=https://callguard-yourname.fly.dev
ADMIN_TOKEN=long-random-string     # protects the /calls log page
OWNER_NAME=Sam                     # spoken in the greeting
SCREEN_MODE=shadow                 # shadow = log only; switch to enforce after a week
# Optional:
# CLAUDE_MODEL=claude-sonnet-5   # default; opus-5 is same accuracy but has a latency tail
# TEST_NUMBERS=+14085550100,+14085550101   # your own test phones; filterable on /calls
# RING_SECONDS=20                  # must be shorter than the carrier no-answer timer (30s)
